{
  "name": "MiniShell",
  "outputfilename": "MiniShell",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev -- --host 127.0.0.1",
  "frontend:dev:serverUrl": "auto",
  "preBuildHooks": {
    "windows/*": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/set-icon.ps1"
  },
  "author": {
    "name": "MiniShell"
  }
}
